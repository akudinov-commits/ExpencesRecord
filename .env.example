HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://localhost:5173
# Configure a web OAuth client with the exact local callback in docs/google-setup.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_SUBJECT=
# Independent 32-byte base64url keys; generate directly into ignored config.
AUTH_SESSION_KEY=
AUTH_FLOW_KEY=
AUTH_SESSION_VERSION=1
# Separate operator-only read-only Sheets grant and isolated test workbook.
GOOGLE_SHEETS_REFRESH_TOKEN=
GOOGLE_TEST_SPREADSHEET_ID=

# Private annual mapping: v1 reads; v2 requires explicit category storageCurrency for writes.
EXPENSE_WORKBOOKS_JSON=

# Separate owner write grant; consent/storage requires explicit operator approval.
GOOGLE_SHEETS_WRITE_REFRESH_TOKEN=

# Explicitly opt in only after isolated write verification; missing/invalid means disabled.
EXPENSE_WRITES_ENABLED=false

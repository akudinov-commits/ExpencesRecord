{
  "name": "expences-record",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev:web": "vite apps/web",
    "dev:api": "node --env-file=.env --import tsx apps/api/src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json && tsc --noEmit -p apps/api/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:boundaries": "depcruise --config .dependency-cruiser.cjs --output-type err apps/web/src apps/api/src api",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run typecheck && npm run lint && npm test && npm run check:boundaries && npm run build",
    "setup:google:owner": "node --env-file-if-exists=.env --import tsx apps/api/src/setup-google.ts owner",
    "setup:google:sheets": "node --env-file=.env --import tsx apps/api/src/setup-google.ts sheets",
    "check:google:sheets": "node --env-file=.env --import tsx apps/api/src/setup-google.ts probe",
    "setup:google:sheets-write": "node --env-file=.env --import tsx apps/api/src/setup-google.ts sheets-write",
    "check:google:sheets-write": "node --env-file=.env --import tsx apps/api/src/setup-google.ts probe-write"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "dependency-cruiser": "18.9.0",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "yaml": "2.9.1"
  }
}
